
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome">
  <div class="flex flex-col items-center justify-center text-center space-y-8 py-20">
    <h1 class="text-7xl resonance-glow mb-4">Atlas Island</h1>
    <p class="text-xl max-w-2xl mx-auto font-light italic opacity-90">
      A sanctuary for healing, ancestral wisdom, and the evolution of the soul.
    </p>
    
    <nav class="flex gap-6 pt-12">
      <a href="/services" class="btn-sovereign px-6 py-2 rounded-full">Services</a>
      <a href="/about" class="btn-sovereign px-6 py-2 rounded-full">About</a>
      <a href="/reviews" class="btn-sovereign px-6 py-2 rounded-full">Resonances</a>
    </nav>
  </div>
</Layout>
